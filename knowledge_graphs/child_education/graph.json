  "domain_overviews": {
    "心理学": {
      "核心问题": [
        "孩子如何理解世界？",
        "成人支持如何促进学习？",
        "安全关系如何影响探索与情绪调节？"
      ],
      "关键主张": [
        "教学要匹配发展阶段。",
        "学习通过互动和支架得到提升。",
        "稳定敏感的照护是学习与探索的心理基础。"
      ]
    },
    "人类学": {
      "核心问题": [
        "不同文化如何养育孩子？",
        "孩子如何在家庭与社区实践中学习？",
        "谁在参与抚育与社会化？"
      ],
      "关键主张": [
        "没有单一普遍正确的育儿模型。",
        "儿童学习常发生在共同体参与中。",
        "多照护者和文化环境会显著影响发展路径。"
      ]
    },
    "脑科学": {
      "核心问题": [
        "早期经验如何塑造大脑？",
        "执行功能如何影响学习？",
        "为什么互动式语言环境很重要？"
      ],
      "关键主张": [
        "早期脑可塑性很强，互动经验会改变神经连接。",
        "执行功能是学习能力的重要底层机制。",
        "语言暴露与社会互动共同推动语言脑系统发展。"
      ]
    }
  },
  "development_tracks": [
    {
      "id": "track_psychology",
      "domain": "心理学",
      "title": "从认知建构到关系支持",
      "summary": "儿童教育心理学的主线，从儿童主动建构知识，到社会互动支持，再到安全关系与情绪调节基础。",
      "stages": [
        {
          "year": "1920s-1930s",
          "title": "认知建构与发展阶段",
          "summary": "Piaget 强调儿童通过行动、试错与图式调整来建构知识，教学应匹配发展准备度。",
          "node_refs": [
            "person_piaget",
            "concept_constructivism",
            "concept_stages",
            "work_piaget_child_thought",
