        },
        {
          "year": "1930s",
          "title": "社会互动与最近发展区",
          "summary": "Vygotsky 将学习理解为社会互动中的发展过程，提出最近发展区与文化工具的重要性。",
          "node_refs": [
            "person_vygotsky",
            "concept_zpd",
            "concept_scaffolding",
            "work_vygotsky_thinking_speech",
            "work_vygotsky_mind_society"
          ]
        },
        {
          "year": "1950s-1970s",
