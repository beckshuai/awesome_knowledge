{
  "metadata": {
    "title": "孩子教育跨学科知识图谱",
    "topic": "儿童教育 / 养育 / 学习发展",
    "domains": [
      "心理学",
      "人类学",
      "脑科学"
    ],
    "language": "zh-CN",
    "created_at": "2026-05-19",
    "description": "围绕儿童教育主题整理的跨学科知识图谱，覆盖核心人物、主要观点、代表著作，以及概念之间的关系。"
  },
  "nodes": [
    {
      "id": "domain_psychology",
      "type": "domain",
      "name": "心理学",
      "summary": "关注儿童认知、情绪、依恋、社会互动与学习机制。"
    },
    {
      "id": "domain_anthropology",
      "type": "domain",
      "name": "人类学",
      "summary": "关注不同文化中的儿童养育、社会化、共同体参与和学习方式。"
    },
    {
      "id": "domain_neuroscience",
      "type": "domain",
      "name": "脑科学",
      "summary": "关注儿童脑发育、神经可塑性、执行功能、语言学习与互动经验。"
    },
    {
      "id": "person_piaget",
      "type": "person",
      "name": "Jean Piaget",
      "name_zh": "让·皮亚杰",
      "domain": "心理学",
      "summary": "提出认知发展阶段论，强调儿童通过与环境互动主动建构知识。"
    },
    {
      "id": "person_vygotsky",
      "type": "person",
      "name": "Lev Vygotsky",
      "name_zh": "列夫·维果茨基",
      "domain": "心理学",
      "summary": "强调社会互动、语言与文化工具在儿童认知发展中的中介作用。"
    },
    {
      "id": "person_bowlby",
      "type": "person",
      "name": "John Bowlby",
      "name_zh": "约翰·鲍尔比",
      "domain": "心理学",
      "summary": "依恋理论提出者，强调稳定照护关系对儿童安全感与探索行为的重要性。"
    },
    {
      "id": "person_ainsworth",
      "type": "person",
      "name": "Mary Ainsworth",
      "name_zh": "玛丽·安斯沃思",
      "domain": "心理学",
      "summary": "扩展依恋理论，强调照护者敏感性与陌生情境研究。"
    },
    {
      "id": "person_rogoff",
      "type": "person",
      "name": "Barbara Rogoff",
      "name_zh": "芭芭拉·罗格夫",
      "domain": "人类学",
      "summary": "将心理学与人类学结合，强调儿童在家庭、社区与共同活动中的学习。"
    },
    {
      "id": "person_mead",
      "type": "person",
      "name": "Margaret Mead",
      "name_zh": "玛格丽特·米德",
      "domain": "人类学",
      "summary": "强调儿童发展、青春期与性别角色受到文化塑造，而非纯粹生物决定。"
    },
    {
      "id": "person_hrdy",
      "type": "person",
      "name": "Sarah Hrdy",
      "name_zh": "莎拉·赫尔迪",
      "domain": "人类学",
      "summary": "提出合作抚育与多照护者支持对人类婴幼儿成长和社会性发展的重要性。"
    },
    {
      "id": "person_kuhl",
      "type": "person",
      "name": "Patricia K. Kuhl",
      "name_zh": "帕特里夏·库尔",
      "domain": "脑科学",
      "summary": "研究婴儿语言学习与脑发育，强调早期语言输入和社会互动的重要性。"
    },
    {
      "id": "person_diamond",
      "type": "person",
      "name": "Adele Diamond",
      "name_zh": "阿黛尔·戴蒙德",
      "domain": "脑科学",
      "summary": "研究儿童执行功能、自我调节与前额叶发育，强调可通过教育干预提升。"
    },
    {
      "id": "concept_constructivism",
      "type": "concept",
      "name": "主动建构学习",
      "domain": "心理学",
      "summary": "儿童不是被动接受知识，而是在探索、操作、提问和反馈中建构理解。"
    },
    {
      "id": "concept_stages",
      "type": "concept",
      "name": "认知发展阶段",
      "domain": "心理学",
      "summary": "感知运动、前运算、具体运算、形式运算四阶段提示教学应考虑发展准备度。"
    },
    {
      "id": "concept_zpd",
      "type": "concept",
      "name": "最近发展区",
      "domain": "心理学",
      "summary": "儿童独立能力与在支持下可达到能力之间的区域，是教学设计的重要抓手。"
    },
    {
      "id": "concept_scaffolding",
      "type": "concept",
      "name": "支架式支持",
      "domain": "心理学",
      "summary": "成人或更有经验者通过示范、提问、提示与分步帮助推动儿童向更高水平发展。"
    },
    {
      "id": "concept_attachment",
      "type": "concept",
      "name": "依恋安全基地",
      "domain": "心理学",
      "summary": "稳定、可得、敏感的照护关系为儿童探索世界提供安全基础。"
    },
    {
      "id": "concept_sensitive_care",
      "type": "concept",
      "name": "敏感回应式照护",
      "domain": "心理学",
      "summary": "高质量互动比单纯陪伴时长更关键，及时准确回应孩子信号是核心。"
    },
    {
      "id": "concept_guided_participation",
      "type": "concept",
      "name": "引导式参与",
      "domain": "人类学",
      "summary": "儿童通过参与家庭、社区、劳动与共同体实践来学习，而不仅依赖课堂讲授。"
    },
    {
      "id": "concept_cultural_learning",
      "type": "concept",
      "name": "文化塑造的发展",
      "domain": "人类学",
      "summary": "儿童成长、青春期经验、性别角色与学习方式都受文化情境塑造。"
    },
    {
      "id": "concept_cooperative_breeding",
      "type": "concept",
      "name": "合作抚育",
      "domain": "人类学",
      "summary": "人类幼儿成长依赖母亲之外的父亲、祖辈、手足、照护者与社区支持。"
    },
    {
      "id": "concept_serve_return",
      "type": "concept",
      "name": "你来我往互动（Serve and Return）",
      "domain": "脑科学",
      "summary": "孩子发出信号、成人及时回应的互动，会塑造神经连接并支持语言、情绪与社会发展。"
    },
    {
      "id": "concept_brain_architecture",
      "type": "concept",
      "name": "脑架构与可塑性",
      "domain": "脑科学",
      "summary": "大脑先搭基础回路再发展复杂能力，早期经验会通过建立与修剪连接影响后续学习与健康。"
    },
    {
      "id": "concept_exec_function",
      "type": "concept",
      "name": "执行功能",
      "domain": "脑科学",
      "summary": "包含抑制控制、工作记忆、认知灵活性，是学习、自我调节与任务管理的重要基础。"
    },
    {
      "id": "concept_early_language",
      "type": "concept",
      "name": "早期语言暴露",
      "domain": "脑科学",
      "summary": "婴幼儿早期语言输入及其社会互动质量会改变语言加工系统的发展轨迹。"
    },
